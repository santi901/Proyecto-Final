# Puerto donde corre este backend (Express).
PORT=3000

# Supabase — mismo proyecto que usa el resto del monorepo. Se usa la
# service-role key, así que este backend bypassa RLS en todas sus queries.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT de acceso/refresh emitidos en login/registro. Access token corto
# ({ id, email, tipo }), refresh token persistido en la tabla refresh_tokens
# para poder revocarlo server-side.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS — verificacionController.js (Rekognition CompareFaces + fotos de DNI/selfie
# a S3) y evidenciaController.js (fotos de evidencia a S3 + URLs firmadas).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# Redis (opcional) — caché efímero de ubicaciones de trabajadores. Si no está
# corriendo, el backend loguea un aviso y sigue funcionando sin ese caché.
REDIS_URL=redis://127.0.0.1:6379
