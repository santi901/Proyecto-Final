# Puerto donde corre este backend (Express).
PORT=3000

# Supabase — mismo proyecto que usa el resto del monorepo. Se usa la
# service-role key, así que este backend bypassa RLS en todas sus queries.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT de acceso/refresh emitidos en login/registro. Access token corto
# ({ id, email, tipo }), refresh token persistido en la tabla refresh_tokens
# para poder revocarlo server-side.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS — verificacionController.js (Rekognition CompareFaces + fotos de DNI/selfie
# a S3) y evidenciaController.js (fotos de evidencia a S3 + URLs firmadas).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# ── MercadoPago (sprint 5: cobro, retención, reembolsos) ─────────────────────
# MODO SIMULADO (demo): si MP_ACCESS_TOKEN está vacío, o PAGOS_SIMULADOS=true, no se
# llama nunca a MercadoPago. AppEmployer muestra su propia pantalla de checkout y el
# pago se aprueba sin cobrar nada; reembolsos y liquidaciones se registran igual.
PAGOS_SIMULADOS=true
# Credenciales en https://www.mercadopago.com.ar/developers/panel/app → tu
# aplicación → "Credenciales de prueba". Para probar sin plata real, creá dos
# usuarios de prueba (vendedor y comprador) en "Cuentas de prueba": la app de MP
# tiene que ser del vendedor, y en el checkout se paga logueado como comprador
# con las tarjetas de prueba de la documentación.
MP_ACCESS_TOKEN=
# "Webhooks" → configurar notificaciones → evento "Pagos" → copiar la clave
# secreta. Sin esto el webhook acepta notificaciones sin verificar la firma.
MP_WEBHOOK_SECRET=

# URL pública de este backend, sin barra final (p. ej. https://api.changuitapp.com
# o un túnel de ngrok en desarrollo). MP la usa para el webhook y para volver
# después del checkout. Si no es https, MP no manda webhooks: igual funciona,
# porque la app consulta GET /api/trabajos/:id/pago y eso sincroniza con MP.
PUBLIC_API_URL=
# Deep link al que vuelve el navegador después de pagar (scheme de AppEmployer).
APP_RETORNO_URL=appemployer://pago

# Clave para las rutas /api/pagos/admin/* (header x-admin-key): listar y marcar
# como pagadas las liquidaciones a trabajadores. Usar algo largo y aleatorio.
ADMIN_API_KEY=

# ── Seguridad / despliegue ───────────────────────────────────────────────────
# Detrás de un proxy que termina TLS (Render, Railway, Fly, nginx): TRUST_PROXY=1
# para que Express lea X-Forwarded-Proto/For, y FORZAR_HTTPS=true para rechazar
# todo lo que no llegue por HTTPS. En desarrollo local, dejar los dos vacíos.
TRUST_PROXY=
FORZAR_HTTPS=
# Orígenes permitidos para la versión web de las apps, separados por coma
# (las apps nativas no mandan Origin). Vacío = cualquiera (desarrollo).
CORS_ORIGINS=

# Redis (opcional) — caché efímero de ubicaciones de trabajadores. Si no está
# corriendo, el backend loguea un aviso y sigue funcionando sin ese caché.
REDIS_URL=redis://127.0.0.1:6379
