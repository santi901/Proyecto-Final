# Puerto donde corre este backend (Express).
PORT=3000

# Supabase — mismo proyecto que usa el resto del monorepo. Se usa la
# service-role key, así que este backend bypassa RLS en todas sus queries.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT de acceso/refresh emitidos en login/registro. Access token corto
# ({ id, email, tipo }), refresh token persistido en la tabla refresh_tokens
# para poder revocarlo server-side.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS — usado por verificacionController.js (Rekognition CompareFaces +
# subida de las fotos de DNI/selfie a S3).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# URL del backend NestJS de Nacho (root /src) — server-to-server, nunca lo ve
# el cliente. Se usa para: matching de trabajadores al crear un trabajo,
# registrar notificaciones (push + log), y disparar calificaciones al
# completar un trabajo. Si no se setea, cae a http://localhost:3001 — andá
# con cuidado con ese fallback fuera de desarrollo local, porque las 3 cosas
# de arriba van a fallar en silencio (quedan logueadas en la consola, pero no
# frenan ninguna respuesta) si no apunta al lugar correcto.
NACHO_API_URL=http://localhost:3001
