# Copiá este archivo a .env.local y completá con la IP local de la máquina
# que está corriendo los backends. Ambos dispositivos deben estar en la misma
# red WiFi. .env.local NO se sube a git.

# Backend de Nico (Express, backend/) — auth, perfiles, trabajos, chat, calificación, verificación, ubicación
EXPO_PUBLIC_API_URL=http://IP_DEL_BACKEND:3000

# Backend de Nacho (NestJS, src/) — token de notificaciones push y foto de evidencia
EXPO_PUBLIC_NACHO_API_URL=http://IP_DEL_BACKEND:3001

# (Opcional) Base pública del bucket de S3 donde el backend de Nacho guarda las fotos de evidencia.
# Normalmente NO hace falta: el backend ya devuelve una URL firmada por foto. Sirve sólo como
# respaldo si algún día el bucket pasa a ser de lectura pública.
# EXPO_PUBLIC_EVIDENCIA_BASE_URL=https://NOMBRE_DEL_BUCKET.s3.REGION.amazonaws.com
