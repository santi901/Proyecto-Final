# Copiá este archivo a .env.local. Ambos dispositivos deben estar en la misma red
# WiFi. .env.local NO se sube a git.
#
# En desarrollo la IP se detecta sola (la de la PC que corre Metro, ver auth.ts), así
# que de estas URLs solo importa el puerto: si la red te cambia la IP no hay que tocar
# nada. Lo que sí se respeta tal cual es una URL https (backend desplegado o túnel).

# Backend único (Express, backend/) — auth, perfiles, trabajos, chat, verificación, ubicación,
# evidencia y notificaciones push
EXPO_PUBLIC_API_URL=http://IP_DEL_BACKEND:3000
