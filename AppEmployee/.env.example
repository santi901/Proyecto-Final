# Copiá este archivo a .env.local y completá con la IP local de la máquina
# que está corriendo los backends (backend/ de Nico y la raíz del repo de Nacho).
# Ambos deben estar en la misma red WiFi. .env.local NO se sube a git.

# Backend de Nico (Express) — auth, empleados, perfiles, trabajos, ubicación
EXPO_PUBLIC_API_URL=http://IP_DE_NACHO:3000

# Backend de Nacho (NestJS) — verificación de identidad (DNI + selfie) y cálculo de viaje
EXPO_PUBLIC_NACHO_API_URL=http://IP_DE_NACHO:3001
