{
  "name": "changuitapp",
  "version": "1.0.0",
  "private": true,
  "description": "ChanguitApp — apps del trabajador y del empleador + backends. Este package.json es el de la raiz: solo tooling de calidad (tests, lint, build) que se ejecuta sobre los cuatro proyectos.",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run tests/unit --coverage",
    "lint": "npm run lint:employee && npm run lint:employer && npm run lint:nacho",
    "lint:employee": "npm --prefix AppEmployee run lint",
    "lint:employer": "npm --prefix AppEmployer run lint",
    "lint:nacho": "cd backend-nacho && npx eslint \"{src,test}/**/*.ts\"",
    "build": "npm run build:employee && npm run build:employer && npm run build:nacho",
    "build:employee": "npm --prefix AppEmployee run typecheck",
    "build:employer": "npm --prefix AppEmployer run typecheck",
    "build:nacho": "npm --prefix backend-nacho run build",
    "backend": "node backend/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "nodemon": "^3.1.14",
    "typescript": "~5.9.2",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi901/Proyecto-Final.git"
  },
  "license": "ISC"
}
